section .data
    msg_start db 'Генерация и распределение чисел...', 10, 0
    msg_res   db 'Готово. Счетчики категорий:', 10, 0
    msg_even  db 'Четные (от 0):    ', 0
    msg_odd   db 'Нечетные (от 128):', 0
    msg_ge    db '>= 50000 (от 256):', 0
    msg_lt    db '< 10000 (от 384): ', 0
    msg_arr   db 'Первые элементы из каждой группы: ', 0
    space     db ' ', 0
    newline   db 10, 0

section .bss
    data_arr  resw 1024      
    
    cnt_even  resd 1
    cnt_odd   resd 1
    cnt_ge    resd 1
    cnt_lt    resd 1
    
    buf       resb 4
    dec_buf   resb 16

section .text
    global _start

_start:
    lea esi, [msg_start]
    call print_string

main_loop:
    call get_random      
    mov cx, ax

    test cx, 1
    jnz .not_even
    mov eax, [cnt_even]
    mov [data_arr + eax*2], cx
    inc dword [cnt_even]
.not_even:

    test cx, 1
    jz .not_odd
    mov eax, [cnt_odd]
    mov [data_arr + 256 + eax*2], cx
    inc dword [cnt_odd]
.not_odd:

    cmp cx, 50000
    jl .not_ge
    mov eax, [cnt_ge]
    mov [data_arr + 512 + eax*2], cx
    inc dword [cnt_ge]
.not_ge:

    cmp cx, 10000
    jge .not_lt
    mov eax, [cnt_lt]
    mov [data_arr + 768 + eax*2], cx
    inc dword [cnt_lt]
.not_lt:

    cmp dword [cnt_even], 128
    jge end_loop
    cmp dword [cnt_odd], 128
    jge end_loop
    cmp dword [cnt_ge], 128
    jge end_loop
    cmp dword [cnt_lt], 128
    jge end_loop

    jmp main_loop

end_loop:
    lea esi, [msg_res]
    call print_string

    lea esi, [msg_even]
    call print_string
    mov cx, [cnt_even]
    call print_dec16
    lea esi, [newline]
    call print_string

    lea esi, [msg_odd]
    call print_string
    mov cx, [cnt_odd]
    call print_dec16
    lea esi, [newline]
    call print_string

    lea esi, [msg_ge]
    call print_string
    mov cx, [cnt_ge]
    call print_dec16
    lea esi, [newline]
    call print_string

    lea esi, [msg_lt]
    call print_string
    mov cx, [cnt_lt]
    call print_dec16
    lea esi, [newline]
    call print_string

    lea esi, [msg_arr]
    call print_string

    mov cx, [data_arr]
    call print_dec16
    lea esi, [space]
    call print_string

    mov cx, [data_arr + 256]
    call print_dec16
    lea esi, [space]
    call print_string

    mov cx, [data_arr + 512]
    call print_dec16
    lea esi, [space]
    call print_string

    mov cx, [data_arr + 768]
    call print_dec16
    lea esi, [newline]
    call print_string

    mov eax, 1
    xor ebx, ebx
    int 0x80

get_random:
    mov  eax, 355
    lea  ebx, [buf]
    mov  ecx, 4
    mov  edx, 1
    int  0x80
    mov  ax, [buf]
    ret

print_string:
    push esi
    call strlen
    mov edx, eax
    pop esi
    mov eax, 4
    mov ebx, 1
    int 0x80
    ret

strlen:
    xor eax, eax
.sl_loop:
    cmp byte [esi + eax], 0
    je .sl_end
    inc eax
    jmp .sl_loop
.sl_end:
    ret

print_dec16:
    mov ax, cx
    mov cx, 10
    xor bx, bx
.pd_loop:
    xor dx, dx
    div cx
    push dx
    inc bx
    test ax, ax
    jnz .pd_loop
.pd_print:
    pop ax
    add al, '0'
    mov [dec_buf], al
    mov eax, 4
    mov ebx, 1
    lea ecx, [dec_buf]
    mov edx, 1
    int 0x80
    dec bx
    jnz .pd_print
    ret
